{
  "name": "fitforge-backend",
  "version": "1.0.0",
  "description": "FitForge Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --verbose --forceExit",
    "test:integration": "jest tests/integration --verbose --runInBand --forceExit",
    "test:regression": "jest tests/regression --verbose --runInBand --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:mutation": "npx stryker run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^7.3.0",
    "@stryker-mutator/jest-runner": "^7.3.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
